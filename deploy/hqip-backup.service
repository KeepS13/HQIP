[Unit]
Description=HQIP scheduled local database and master key backup
After=network-online.target hqip-storage.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/hqip-runtime/bin/python3 -B /opt/hqip-control/current/scripts/automatic_backup.py
ExecStopPost=/opt/hqip-runtime/bin/python3 -B /opt/hqip-control/current/scripts/automatic_backup.py --record-abnormal
TimeoutStartSec=35min
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/hqip-control /var/backups/hqip-control /opt/hqip-control/deploy.lock
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
LogNamespace=hqip-control
