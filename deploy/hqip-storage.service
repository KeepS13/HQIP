[Unit]
Description=HQIP private PostgreSQL and Redis
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/etc/hqip-storage
ExecStart=/usr/bin/docker compose -f /etc/hqip-storage/compose.yaml up -d --wait --wait-timeout 120
ExecStop=/usr/bin/docker compose -f /etc/hqip-storage/compose.yaml stop
TimeoutStartSec=180
TimeoutStopSec=90
UMask=0077

[Install]
WantedBy=multi-user.target
